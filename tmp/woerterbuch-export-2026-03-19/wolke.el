			      :qualifiers nil :examples nil
			      :definitions
			      ((:id 1 :dwds-id "d-1-3-1" :label "a)"
				    :definition
				    "intensiver Geruch, Duftwolke"
				    :qualifiers nil :examples
				    ("der Wind trug eine Wolke von Rosenduft, Benzin, Gestank heran"
