				    :definitions nil)
			       (:id 2 :dwds-id "d-1-3-2" :label "b)"
				    :definition
				    "größere Ansammlung, besonders von Tieren"
				    :qualifiers nil :examples
				    ("Wolken von Mücken standen über der Wiese"
				     "eine Wolke von Spatzen flog auf")
