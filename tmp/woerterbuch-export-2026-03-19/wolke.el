		  ((:id 1 :lemma "Wolke" :title "Wolke, Substantiv, f"
			:wortart "Substantiv" :grammar "Substantiv"
			:origin
			"mittelhochdeutsch wolken, althochdeutsch wolkan, germanisch * wulkna-, belegt seit dem 8. Jahrhundert. Das Wort geht möglicherweise auf die indogermanische Wurzel * u̯elg- „ feucht, nass “ zurück. Ursprünglich ist es ein Neutrum, erst seit dem Spätmittelhochdeutschen ist „die Wolke“ weiblich."
			:idioms
			("auf Wolke sieben schweben"
			 "aus allen Wolken fallen")
			:synonyms ((:sense "3" :items ("Gaswolke")))
			:url "https://de.wiktionary.org/wiki/Wolke"
			:definitions
			((:id 1 :label "1" :definition
			      "große Ansammlung von Wasserteilchen in der Troposphäre"
			      :qualifiers nil :examples
			      ("Der Himmel ist mit Wolken bedeckt."
			       "„In welcher Hinsicht, auf welche Weise können die Wolken und Gletscher der Hochgebirge Schicksal spielen?“"
			       "„Gelbliche Wolken fliegen über den Morgenhimmel.“"
			       "„Es fing bereits an, hell zu werden, die Wolken hatten sich zerteilt, und es regnete nicht mehr.“")
			      :definitions nil)
			 (:id 2 :label "2" :definition
